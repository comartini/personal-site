---
import { getEntry } from 'astro:content';
const contact = await getEntry('site', 'contact');
const { email, phone, socialLabel, socialHref, copyrightName } = contact.data;
const year = new Date().getFullYear();
---
<style>
  .footer {
    width: 100%;
    box-sizing: border-box;
    background: var(--color-bg-footer);
    border-top: 1px solid var(--color-hairline);
    padding: 56px 64px 32px 64px;
    font-family: var(--font-sans);
  }
  .footer a:hover { color: var(--color-accent-hover); }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 32px;
  }
  .col { display: flex; flex-direction: column; gap: 10px; }
  .col--right { align-items: flex-end; }
  .label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }
  .email { font-family: var(--font-serif); font-size: 20px; color: var(--color-ink); }
  .phone { font-size: 14px; color: var(--color-muted); }
  .social { font-size: 14px; color: var(--color-ink); }
  .copyright {
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px solid var(--color-hairline);
    font-size: 12px;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .footer { padding: 40px 24px 24px 24px; }
    .col--right { align-items: flex-start; }
  }
</style>
<div class="footer">
  <div class="row">
    <div class="col">
      <div class="label">Get in Touch</div>
      <a class="email" href={`mailto:${email}`}>{email}</a>
      {phone && <div class="phone">{phone}</div>}
    </div>
    {socialHref && (
      <div class="col col--right">
        <div class="label">Elsewhere</div>
        <a class="social" href={socialHref}>{socialLabel}</a>
      </div>
    )}
  </div>
  <div class="copyright">© {year} {copyrightName}</div>
</div>
