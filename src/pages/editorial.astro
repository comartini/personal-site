---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('editorial')).sort((a, b) => a.data.order - b.data.order);
const entries = items.map((item) => ({
  href: item.data.href,
  title: item.data.title,
  description: item.data.description,
  ctaLabel: 'Visit →',
}));
---
<BaseLayout title="Editorial">
  <div class="wrap" style="padding:96px 32px 8px 32px;">
    <div class="kicker" style="margin-bottom:18px;">Editorial</div>
    <h1>Editorial Work</h1>
    <p style="font-size:18px; line-height:1.7; color:var(--color-body); max-width:640px; margin:0;">Connor edits alongside his own research and writing, for a small press and an online magazine at the intersection of scholarship and popular culture.</p>
  </div>
  <EntryList entries={entries} />
</BaseLayout>
