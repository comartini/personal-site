---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection, render } from 'astro:content';

const home = await getEntry('home', 'index');
const { Content: HomeBio } = await render(home);

const currently = await getEntry('homeCurrently', 'index');
const { Content: CurrentlyNote } = await render(currently);

const pillars = (await getCollection('homePillars')).sort((a, b) => a.data.order - b.data.order);
const pillarContent = await Promise.all(pillars.map(async (p) => ({ data: p.data, Content: (await render(p)).Content })));
---
<BaseLayout title="Home">
  <style>
    .hero { padding: 96px 32px 56px 32px; }
    .hero h1 {
      font-size: 56px;
      line-height: 1.08;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin: 0 0 28px 0;
      color: var(--color-ink);
    }
    .hero .kicker { margin-bottom: 18px; }
    .hero-bio { font-size: 19px; line-height: 1.65; color: var(--color-body); }
    .rule { max-width: 760px; margin: 0 auto; border-top: 1px solid var(--color-hairline); }
    .pillars {
      padding: 52px 32px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 48px;
    }
    .pillar { display: flex; flex-direction: column; gap: 10px; }
    .pillar-label {
      font-family: var(--font-sans);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-accent);
      font-weight: 600;
    }
    .pillar-body :global(p) { font-size: 16px; line-height: 1.55; color: var(--color-body); margin: 0; }
    .pillar a.more {
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--color-ink);
      margin-top: 4px;
    }
    .currently-wrap { padding: 8px 32px 100px 32px; }
    .currently-inner { border-top: 1px solid var(--color-hairline); padding-top: 40px; }
    .currently-label {
      font-family: var(--font-sans);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-accent);
      font-weight: 600;
      margin-bottom: 14px;
    }
    .currently-inner :global(p) {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 21px;
      line-height: 1.6;
      color: var(--color-ink);
      margin: 0;
    }
    .currently-inner :global(.normal) { font-style: normal; }
    @media (max-width: 640px) {
      .pillars { grid-template-columns: 1fr; }
    }
  </style>

  <div class="wrap hero">
    <div class="kicker">{home.data.kicker}</div>
    <h1>{home.data.name}</h1>
    <div class="hero-bio"><HomeBio /></div>
  </div>

  <div class="rule"></div>

  <div class="wrap pillars">
    {pillarContent.map(({ data, Content }) => (
      <div class="pillar">
        <div class="pillar-label">{data.label}</div>
        <div class="pillar-body"><Content /></div>
        <a class="more" href={data.href}>Read more →</a>
      </div>
    ))}
  </div>

  <div class="wrap currently-wrap">
    <div class="currently-inner">
      <div class="currently-label">{currently.data.kicker}</div>
      <CurrentlyNote />
    </div>
  </div>
</BaseLayout>
