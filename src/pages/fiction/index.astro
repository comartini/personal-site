---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('fiction')).sort((a, b) => a.data.order - b.data.order);
const entries = items.map((item) => ({
  href: `/fiction/${item.slug}`,
  title: item.data.title,
  description: item.data.cardDescription,
  ctaLabel: 'Read →',
}));
---
<BaseLayout title="Fiction">
  <div class="wrap" style="padding:96px 32px 8px 32px;">
    <div class="kicker" style="margin-bottom:18px;">Fiction</div>
    <h1>Fiction</h1>
    <p style="font-size:18px; line-height:1.7; color:var(--color-body); max-width:640px; margin:0;">Alongside his academic work, Connor writes science fiction — novels about memory, technology, and the futures we choose to believe in.</p>
  </div>
  <EntryList entries={entries} />
</BaseLayout>
